{
  "name": "visualizador-java",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Jorge Zepeda",
  "description": "Visualizador de ejecución paso a paso de Java para bachillerato, en español de México.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JorgeZepeda1/VisualizadorJava.git"
  },
  "homepage": "https://JorgeZepeda1.github.io/VisualizadorJava/",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --project motor --project interfaz --reporter=dot",
    "test:navegadores": "vitest run --project navegadores --reporter=dot",
    "e2e": "playwright test --reporter=dot",
    "rendimiento": "playwright test -c pruebas/rendimiento --reporter=dot",
    "lint": "eslint . --quiet",
    "tipos": "tsc -p tsconfig.motor.json --noEmit && tsc -p tsconfig.trabajador.json --noEmit && tsc -p tsconfig.interfaz.json --noEmit && tsc -p tsconfig.herramientas.json --noEmit",
    "presupuesto": "node herramientas/presupuesto-tamano.ts",
    "licencias": "node herramientas/licencias.ts",
    "ci": "npm run lint && npm run tipos && npm test && npm run build && npm run presupuesto && npm run licencias",
    "oraculo:goldens": "node herramientas/oraculo/generar-goldens.ts",
    "oraculo:verificar": "node herramientas/oraculo/verificar-goldens.ts",
    "oraculo:datos": "node herramientas/oraculo/generar-datos.ts",
    "oraculo:mutantes": "node herramientas/oraculo/mutantes.ts",
    "oraculo:generados": "node herramientas/oraculo/programas-generados.ts",
    "medir:plataforma": "node herramientas/oraculo/medir-plataforma.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@codemirror/language": "6.12.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-java": "6.0.2",
    "lz-string": "1.5.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "7.4.1",
    "vitest": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.1.1",
    "fast-check": "4.10.2",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.70.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "@axe-core/playwright": "4.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.20.4"
  }
}
